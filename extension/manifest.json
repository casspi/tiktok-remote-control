{
  "manifest_version": 3,
  "name": "DouYin Remote Agent",
  "version": "1.1.0",
  "description": "Receive commands from phone and control douyin.com",
  "permissions": [
    "storage",
    "debugger"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.douyin.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
